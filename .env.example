# Supabase del proyecto único y compartido (ver README > "Poner en marcha
# Supabase"). SOLO la service role key: el navegador nunca habla con
# Supabase directamente, todo pasa por rutas de Next.js server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conversions API de Meta: un token por pixel, META_CAPI_TOKEN_<id del pixel>
# (ver src/logica/pixel-meta.ts). Sin token, el pixel del navegador anda solo.
# META_CAPI_TOKEN_1104531105669169=
# Para ver los eventos en "Probar eventos" sin contarlos como reales:
# META_TEST_EVENT_CODE=
