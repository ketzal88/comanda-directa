{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Write(.claude/)",
      "Edit(.claude/)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(skills/)",
      "Edit(skills/)",
      "Write(landing/)",
      "Edit(landing/)",
      "Write(presencia-carta/)",
      "Edit(presencia-carta/)",
      "Write(sagrado-sushi-carta/)",
      "Edit(sagrado-sushi-carta/)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/core/hooks/scripts/canonical-guard.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/core/hooks/scripts/pre-push-guard.py",
            "timeout": 330
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/core/hooks/scripts/secret-scan-guard.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/core/hooks/scripts/filter-verbose-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/core/hooks/scripts/close-guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
